# Copy this file to ".env" (same folder as index.php) and fill it in. Never share or commit the real .env.

# --- Environment ---
APP_ENV=production               # "production" on a live site (forces HTTPS, hides errors). "development" on XAMPP.
TRUST_PROXY=0
FORCE_HTTPS=0                    # 1 = always redirect to HTTPS (also on XAMPP, if you have enabled its https://localhost). Automatic when APP_ENV=production.                    # 1 only if a trusted proxy/CDN in front of the site sets X-Forwarded-Proto

# --- Database (create the database + user in your hosting control panel) ---
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# --- Encrypted database connection (only needed when the database runs on ANOTHER server) ---
DB_SSL=0                         # 1 = require TLS to the database; the site refuses to run if the connection is not encrypted
DB_SSL_CA=                       # path to the database server's CA certificate (lets the site verify the server)
DB_SSL_VERIFY=1
DB_SSL_CERT=
DB_SSL_KEY=

# --- Secrets ---
DATA_KEY=                        # 64 hex characters, encrypts customer names, phones and booking notes. php -r "echo bin2hex(random_bytes(32));"
                                 # If empty one is generated and saved automatically. BACK IT UP: without it that data can never be read again.
APP_SECRET=                      # optional: 64 random characters. If empty, one is generated and saved automatically.
ADMIN_SETUP_KEY=                 # temporary: 12+ random characters, used once at /admin/setup-admin.php. REMOVE after creating the admin.

# --- Email (sends the verification code) ---
MAIL_DRIVER=smtp                 # smtp (default) | mail (PHP's built-in mail(); then only MAIL_FROM / MAIL_FROM_NAME are used)
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl              # ssl (port 465) | tls (port 587) | none
MAIL_USER=no-reply@yourdomain.com
MAIL_PASS=
MAIL_FROM=no-reply@yourdomain.com
MAIL_FROM_NAME=Stillwater Spa

# --- Optional security tuning ---
CSP=enforce                      # enforce | report | off (Content-Security-Policy)
ADMIN_IDLE_SECONDS=1800          # sign admin out after this much inactivity
USER_IDLE_SECONDS=7200
SESSION_MAX_SECONDS=43200
# abuse limits (per hour)
OTP_LIMIT_IP=20
OTP_LIMIT_VERIFY_IP=60
